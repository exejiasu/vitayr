{
    "name": "Vitayr",
    "description": "dvd/modified xiaov2board 1.7.5 兼容主题",
    "version": "1.2.0",
    "images": "https://assets.imgix.net/unsplash/hotairballoon.jpg?w=1280&h=853&fit=crop&crop=right",
    "configs": [
        {
            "label": "主题语言",
            "placeholder": "请选择默认语言",
            "field_name": "theme_default_i18n",
            "field_type": "select",
            "select_options": {
                "zh-TW": "中文",
                "en-US": "English",
                "ja-JP": "日本語"
            },
            "default_value": "zh-TW"
        },
        {
            "label": "节点状态 API",
            "placeholder": "请输入套用 Cloudflare 橙云的 API 地址",
            "field_name": "node_status_api_url",
            "field_type": "input",
            "default_value": ""
        },
        {
            "label": "主题色",
            "placeholder": "请输入十六进制颜色",
            "field_name": "theme_color",
            "field_type": "input",
            "default_value": "#3b5998"
        },
        {
            "label": "自定义页脚 HTML",
            "placeholder": "可以插入客服 JS 等",
            "field_name": "custom_html",
            "field_type": "textarea"
        }
    ]
}
